<?xml version="1.0" encoding="utf-8"?>
<!-- 实验三：难度选择页面（静态布局，XML 声明） -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/bg5"
        android:scaleType="centerCrop"
        android:contentDescription="@string/menu_background_desc" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="32dp">

        <TextView
            android:id="@+id/title_aircraft_war"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="80dp"
            android:text="@string/app_name"
            android:textColor="#FFFFFF"
            android:textSize="40sp"
            android:textStyle="bold"
            android:maxLines="1" />

        <Button
            android:id="@+id/btn_easy"
            android:layout_width="260dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="72dp"
            android:text="@string/difficulty_easy"
            android:textSize="20sp" />

        <Button
            android:id="@+id/btn_normal"
            android:layout_width="260dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/difficulty_normal"
            android:textSize="20sp" />

        <Button
            android:id="@+id/btn_hard"
            android:layout_width="260dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/difficulty_hard"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="260dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/music_switch"
                android:textColor="#FFFFFF"
                android:textSize="18sp" />

            <Switch
                android:id="@+id/switch_music"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
